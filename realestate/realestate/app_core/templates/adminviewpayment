{% load static %}
{% include 'Layout/Partials/Admin/header.html' %}

<div class="container">
  <div class="table-content">
    <h1 class="text-primary fw-bold mb-4">Property Listings</h1>

    <table class="table table-striped table-bordered">
      <thead class="table-primary">
        <tr>
          <th>Number</th>
          <th>Account Holder Name</th>
          <th>Account No</th>
          <th>Expiry Date</th>
        </tr>
      </thead>

      <tbody>
        {% for payment in adminviewpayment %}
        <tr>
          <td>{{ forloop.counter }}</td>
          <td>{{ payment.name }}</td>
          <td>{{ payment.number }}</td>
          <td>{{ payment.expiry_date }}</td>
        </tr>
        {% empty %}
        <tr>
          <td colspan="4" class="text-center">
            No sellers registered yet.
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

{% include 'Layout/Partials/Admin/footer.html' %}